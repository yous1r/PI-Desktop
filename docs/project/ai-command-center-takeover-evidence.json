  "integrationEdits": [
    {
      "path": "packages/agent-host/src/index.ts",
      "change": "Export ./command-center-control.js so the RACP dispatcher and Rust repository adapter can import the shared control service, contracts and result parser."
    },
    {
      "path": "crates/host-core/src/db.rs",
      "change": "Bump SCHEMA_VERSION to 31 and re-export the versioned command-center migration."
    },
    {
      "path": "crates/host-core/src/db/repositories.rs",
      "change": "Fresh creation applies command_center::SCHEMA_DDL; Database::open runs migrate_v30_to_v31 for v30 files and validates cc_* objects on every open."
    },
    {
      "path": "crates/host-core/src/db/command_center_migration.rs",
      "change": "Add the backup/transaction/version-stamp wrapper migrate_v30_to_v31 and three tests (fresh v31, atomic populated v30 upgrade, non-v30 refusal)."
    },
    {
      "path": "docs/spec/03-runtime/04-data-storage.md",
      "change": "Record schema v31, the v30 backup, the additive cc_* tables and fail-closed validation."
    },
    {
      "path": ".gitignore",
      "change": "Re-include crates/host-core/src/owner_handoff/target/ so this source module is not hidden by the global target/ build-output rule."
    },
    {
      "path": "crates/host-core/src/owner_handoff/mod.rs",
      "change": "Declare pub(crate) mod target so the restricted successor bootstrap compiles and its tests run. The CLI entry point is not wired yet."
    },
    {
      "path": "crates/host-core/src/owner_handoff/target/tests.rs",
      "change": "Use the repository target scratch directory instead of the OS temp directory, which this managed host denies to the test process."
    },
    {
      "path": "crates/host-core/src/owner_handoff/target/tests/bootstrap_tests.rs",
      "change": "Pin the envelope build schema to the current SCHEMA_VERSION; the shared H2 fixture intentionally records schema 30."
    },
    {
      "path": "packages/racp/src/index.ts",
      "change": "Export the command-center dispatcher factory so a parent can register the methods after wiring the real service. Catalog registration and capability advertisement remain unchanged."
    },
    {
      "path": "packages/racp/src/command-center-dispatch.test.ts",
      "change": "Add three seam tests for the dispatcher: prefixed method list, namespace stripping with principal forwarding, and refusal of unknown operations."
    }
  ],
