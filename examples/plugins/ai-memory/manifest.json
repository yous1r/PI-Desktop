{
  "schemaVersion": 1,
  "id": "local.ai-memory",
  "name": "ai-memory",
  "version": "0.1.0",
  "description": "Project-scoped memory capture, recall, handoff and diagnostics",
  "author": "PI-Desktop",
  "main": "main.cjs",
  "ui": { "panel": "ui/index.html", "width": 760, "height": 800, "title": { "en": "Memory", "zh-CN": "记忆" } },
  "contributes": {
    "commands": [{ "id": "ai-memory.open", "title": "Memory: settings and diagnostics / 记忆：设置和诊断", "keywords": ["memory", "记忆", "handoff"] }],
    "agentExtensions": ["agent-extension.js"],
    "agentExtensionOperations": [
      { "name": "status", "readOnly": true },
      { "name": "recall", "readOnly": true },
      { "name": "capture", "readOnly": false },
      { "name": "retire", "readOnly": false },
      { "name": "query", "readOnly": true },
      { "name": "readPage", "readOnly": true },
      { "name": "briefing", "readOnly": true },
      { "name": "listHandoffs", "readOnly": true },
      { "name": "writePage", "readOnly": false },
      { "name": "acceptHandoff", "readOnly": false },
      { "name": "beginHandoff", "readOnly": false },
      { "name": "cancelHandoff", "readOnly": false },
      { "name": "maintenance", "readOnly": false }
    ],
    "services": [{ "id": "outbox", "label": "Memory delivery", "autoRestart": true }],
    "skills": ["skills/memory.md"]
  },
  "permissions": ["ui.panel", "agent.extension", "agent.prompt.inject", "net.connection", "fs.read", "background.service"],
  "fs": { "read": { "root": "workspace", "scope": [".ai-memory.toml"] } },
  "engines": { "piDesktop": ">=0.22.1-beta.5" },
  "activationEvents": ["onStartup", "onCommand:ai-memory.open"]
}
