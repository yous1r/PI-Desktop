{
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"files": {
		"includes": [
			"apps/desktop/src/features/app/**/*.ts",
			"apps/desktop/src/features/app/**/*.tsx",
			"apps/desktop/src/features/chat/composer/**/*.ts",
			"apps/desktop/src/features/chat/composer/**/*.tsx",
			"apps/desktop/src/features/plugins/**/*.ts",
			"apps/desktop/src/features/plugins/**/*.tsx",
			"apps/desktop/src/features/settings/**/*.ts",
			"apps/desktop/src/features/settings/**/*.tsx",
			"apps/desktop/electron/main/runtime/session-launch.ts",
			"apps/desktop/electron/main/ipc/workspace-ipc.ts",
			"packages/shared/src/types/**/*.ts",
			"packages/shared/src/owner-control*.ts",
			"scripts/e2e-owner-local-control.mjs",
			"packages/shared/src/execution-fence*.ts",
			"packages/host-runtime/src/execution-fence*.ts",
			"scripts/e2e-execution-fence.mjs",
			"packages/host-runtime/src/{host-process,host-write-admission,turn-persistence,turn-events,runtime-service}.ts",
			"packages/host-runtime/src/{host-write-admission,turn-persistence,turn-events,runtime-service}.test.ts",
			"packages/host-runtime/src/host-data-directory*.ts",
			"packages/host-runtime/src/process-exit-confirmation*.ts",
			"scripts/e2e-process-exit-confirmation.mjs",
			"scripts/e2e-host-data-owner.mjs",
			"scripts/e2e-relocation-capability-keys.mjs",
			"scripts/e2e-background-task-stop.mjs",
			"scripts/e2e-remote-path-permissions.mjs",
			"packages/agent-host/src/{event-log,event-log.test,replay-byte-budget}.ts",
			"packages/racp/src/racp.test.ts",
			"scripts/check-architecture.mjs",
			"scripts/e2e/*.mjs",
			"scripts/e2e/command-center/*.mjs",
			"scripts/e2e-command-center-*.mjs"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"correctness": {
				"noUnusedVariables": "error"
			}
		}
	}
}
